# Connection details for the InfluxDB you already run.
# Copy this file to .env and fill in the token.

# InfluxDB 2.x on your other machine.
INFLUX_URL=http://192.168.1.22:8086
INFLUX_ORG=home
INFLUX_BUCKET=ergon-data

# All-Access token, or a token with write permission on the bucket above.
# InfluxDB UI: Load Data -> API Tokens -> Generate API Token.
INFLUX_TOKEN=

# Ergon meter timestamps are local Queensland time, which has no DST.
TZ=Australia/Brisbane

# Set to 1 to parse and summarise the CSVs without writing to InfluxDB.
DRY_RUN=
